{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "properties": {
    "breadcrumbs": {
      "description": "Folders in hierarchy order from root to this folder, inclusive.",
      "items": {
        "description": "A breadcrumb element",
        "properties": {
          "name": {
            "description": "Name of the folder (\"/\" for root).",
            "type": "string"
          },
          "uri": {
            "description": "URI representing the folder",
            "format": "uri",
            "type": "string"
          }
        },
        "required": [
          "name",
          "uri"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [
    "breadcrumbs"
  ]
}