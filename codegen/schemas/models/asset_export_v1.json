{
  "$schema": "http://json-schema.org/draft-04/schema#",
  "additionalProperties": false,
  "properties": {
    "asset_data": {
      "additionalProperties": false,
      "description": "Set of properties that are applicable for asset data.",
      "properties": {
        "asset_uri": {
          "description": "Document Cloud asset url. Note that only assets that were imported from an external provider can be exported.",
          "format": "uri",
          "type": "string"
        }
      },
      "required": [
        "asset_uri"
      ],
      "type": "object"
    },
    "external_asset_data": {
      "additionalProperties": false,
      "description": "Set of properties that are applicable for external asset data.",
      "properties": {
        "access_token": {
          "description": "External token for 3rd party.",
          "minLength": 1,
          "type": "string"
        },
        "asset": {
          "description": "External asset identifier.",
          "minLength": 1,
          "type": "string"
        },
        "cloud_type": {
          "description": "External cloud type identifier for 3rd party.",
          "enum": [
            "DROPBOX",
            "ONEDRIVE",
            "GDRIVE",
            "BOX"
          ],
          "type": "string"
        },
        "conflict_behaviour": {
          "description": "External asset conflict behavior for 3rd party.",
          "minLength": 1,
          "type": "string"
        },
        "etag": {
          "description": "External asset etag for 3rd party.",
          "minLength": 1,
          "type": "string"
        },
        "name": {
          "description": "The name for the external asset. The preferred way of specifying the filename.",
          "minLength": 1,
          "type": "string"
        },
        "path_type": {
          "description": "External asset identifier type.",
          "enum": [
            "ID",
            "FILE_PATH",
            "URI"
          ],
          "type": "string"
        }
      },
      "required": [
        "cloud_type",
        "asset",
        "path_type",
        "access_token"
      ],
      "type": "object"
    }
  },
  "required": [
    "asset_data",
    "external_asset_data"
  ]
}